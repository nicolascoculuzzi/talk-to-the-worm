PORT=3000
# Behind Railway / Render / Fly / Cloudflare:
TRUST_PROXY=1
# Enables /mod and /launch. Use a long random string.
ADMIN_TOKEN=
# e.g. https://brainworm.example (also used for link previews)
ALLOWED_ORIGINS=
PUBLIC_URL=
# Where logs, proofs, the leaderboard, mod settings and the launch state live. Put it on a persistent disk.
LOG_DIR=var
CHUNK_MINUTES=60
# OpenTimestamps (free Bitcoin timestamps of each sealed hour): 1 or 0
OTS=1

# $WORM (Solana / pump.fun; the coin is named BRAINWORM). Leave TOKEN_MINT empty until launch; /launch sets it when the launch confirms.
TOKEN_MINT=
BIG_BUY_SOL=1
TRADES_PER_SEC=0.7
TX_URL=https://solscan.io/tx/
SOLANA_RPC=https://api.mainnet-beta.solana.com

# Optional header / coin section
SITE_TICKER=$WORM
SITE_CONTRACT=
SITE_CHAIN=
SITE_LINKS=

# Optional Twitch chat bridge ("!worm message", "!poke")
TWITCH_CHANNEL=
TWITCH_PREFIX=!worm

# Bot protection: proof-of-work bits each browser solves before sending (~0.1 s at 16; 0 disables)
POW_BITS=16

# Limits
MSG_PER_MIN=12
MSG_PER_MIN_IP=60
POKES_PER_SEC=3
POKES_PER_SEC_IP=10
POKES_PER_SEC_GLOBAL=20
TUGS_PER_HOUR_IP=20
MAX_QUEUE=12
MAX_TUGS_QUEUED=1
LAMPS_PER_HOUR_IP=12
MAX_LAMPS_QUEUED=1
MAX_CONN_PER_IP=24
CONN_PER_MIN_IP=40
MSG_PER_SEC_GLOBAL=4
FEED_SIZE=60
BOARD_SIZE=10
# Live trades come free from a Solana node's log stream; set a funded PumpPortal key to use PumpPortal instead
SOLANA_WS=wss://api.mainnet-beta.solana.com
PUMPPORTAL_API_KEY=
# The launch's image and metadata go to IPFS via Pinata when set (pump.fun's own uploader otherwise).
# SPAWN coins' pictures and metadata too; without it they're served from LOG_DIR, which must then be a persistent disk.
PINATA_JWT=
# SPAWN, the launchpad. Its rewards wallet (a public address): every new coin names it as its pump.fun creator, so every
# coin's creator rewards collect there. Not the wallet that launches $WORM. Can also be set once on /launch.
SPAWN_OWNER=
# Serve SPAWN coins' pictures from LOG_DIR even when LOG_DIR isn't set here (only on a disk that lasts: metadata can't move).
SPAWN_LOCAL_META=0
# SPAWN trades through Jupiter's free API. A Jupiter API key (a paid plan) lets more buys go through in one transaction.
JUPITER_API_KEY=
# The lab runs once at start in a worker and is cached in LOG_DIR; LAB=0 turns it off
LAB=1
